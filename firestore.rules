rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Open sign-up: any signed-in Google account can join.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid}       { allow read: if signedIn(); allow write: if isMe(uid); }
    match /plans/{uid}       { allow read: if signedIn(); allow write: if isMe(uid); }
    match /notes/{uid}       { allow read, write: if isMe(uid); }           // private notes
    match /roadmaps/team     { allow read, write: if signedIn(); }         // shared team roadmap
    match /roadmaps/{uid}    { allow read: if signedIn(); allow write: if isMe(uid); }
    match /roadmapLog/{id}   { allow read, create: if signedIn(); }
    match /problems/{id} {                                                 // DSA log
      allow read, create: if signedIn();
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /posts/{id} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /messages/{id} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /boards/{id} {
      allow read, write: if signedIn();
      match /files/{fileId} { allow read, write: if signedIn(); }
    }
  }
}
